# Optional absolute data-hub BFF origin for browser runtime.
# Prefer leaving this empty in Vite development so requests use the same-origin /api proxy.
VITE_DATAHUB_API_BASE_URL=

# Vite /api proxy target. Fill this with an explicitly approved DataHub/BFF.
# Leaving both this and VITE_DATAHUB_BFF_PORT empty intentionally blocks startup.
# - POST /api/auth/login for platform users
# - POST /api/admin/login for system administrators
VITE_DATAHUB_PROXY_TARGET=

# Optional local data-hub BFF port. Set this only when deliberately switching
# Xingshu to a locally running DataHub BFF.
VITE_DATAHUB_BFF_PORT=

# Analytics requests intentionally use the generic /api BFF proxy. Do not route
# browser requests directly to analytics-service: the BFF validates the JWT and
# injects the trusted user/space identity headers required by that service.

# Query assets/favorite-question UI.
# The UI can be previewed locally; persistence still requires analytics-service.
VITE_QUERY_ASSETS_ENABLED=true

# Optional analytics-dashboard designer subapp entry.
# Start analytics-dashboard apps/web on 5174 or replace with a proxied production path.
VITE_DASHBOARD_EDITOR_URL=http://127.0.0.1:5174/workbenches

# Optional DataHub web UI origin for /cloud “添加知识库”.
# Leave empty to reuse VITE_DATAHUB_API_BASE_URL, VITE_DATAHUB_PROXY_TARGET,
# or VITE_DATAHUB_BFF_PORT from login. Do not put tokens in this URL.
VITE_DATAHUB_APP_URL=
# Path on that origin for creating/managing knowledge bases.
# Leave empty to use DataHub’s /platform/knowledge.
VITE_DATAHUB_KB_MANAGE_PATH=
# Optional detail path. Use {spaceId} and {id}. Leave empty for
# /platform/knowledge/{spaceId}/{id}.
VITE_DATAHUB_KB_DETAIL_PATH=
# Production only: set true when this origin reverse-proxies DataHub’s
# /platform and hashed /assets, so “添加知识库” can reuse the current login.
# Vite development already does this. Do not put tokens in any URL.
VITE_DATAHUB_UI_SAME_ORIGIN=

# Public-document requests stay same-origin and are authenticated by the
# dedicated /api/official-document gateway. Production never falls back to demo data.
VITE_OFFICIAL_DOCUMENT_API_BASE_URL=/api/official-document
VITE_OFFICIAL_DOCUMENT_API_MODE=gateway

# Optional enterprise support/password-reset entry. Leave empty to show the
# explicit "contact your administrator" fallback.
VITE_SUPPORT_URL=
