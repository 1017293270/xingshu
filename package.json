{
  "name": "xingshu-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "check:bundle": "node scripts/check-bundle-budget.mjs",
    "pretest:visual": "node scripts/check-playwright-browser.mjs",
    "test:visual": "playwright test",
    "test:visual:setup": "playwright install chromium",
    "test:visual:typecheck": "tsc -p tsconfig.playwright.json",
    "verify": "npm run lint && npm test && npm run build && npm run check:bundle && npm run test:visual:typecheck"
  },
  "dependencies": {
    "@ant-design/v5-patch-for-react-19": "^1.0.3",
    "@phosphor-icons/react": "^2.1.10",
    "@phosphor-icons/vue": "^2.2.1",
    "@tanstack/react-query": "^5.101.2",
    "antd": "^5.29.3",
    "echarts": "^6.1.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-markdown": "^10.1.0",
    "react-router": "^8.3.0",
    "remark-gfm": "^4.0.1",
    "vue": "^3.5.39",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@eslint/js": "^9.39.0",
    "@playwright/test": "^1.61.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^26.1.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "@vitejs/plugin-vue": "^6.0.7",
    "@vue/compiler-sfc": "^3.5.39",
    "eslint": "^9.39.0",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.26",
    "globals": "^16.4.0",
    "jsdom": "^29.1.1",
    "postcss": "^8.5.25",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.65.0",
    "vite": "^8.1.3",
    "vitest": "^4.1.9"
  }
}
